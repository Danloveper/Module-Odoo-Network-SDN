<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="network_monitor_view_tree" model="ir.ui.view">
        <field name="name">network.monitor.view.tree</field>
        <field name="model">network.monitor</field>
        <field name="arch" type="xml">
            <tree string="Metricas de Monitoreo">
                <field name="name" />
                <field name="last_update" />
            </tree>
        </field>
    </record>

    <record id="network_monitor_view_form" model="ir.ui.view">
        <field name="name">network.monitor.view.form</field>
        <field name="model">network.monitor</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <h1 class="mt0">
                        <field name="device_id" class="mb16" />
                    </h1>
                    <group>
                        <group>
                            <field name="bandwidth" />
                            <field name="bandwidth_info" />
                            <field name="latency" />
                        </group>
                        <group>
                            <field name="traffic" />
                            <field name="availability" />
                            <field name="last_update" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="network_monitor_action" model="ir.actions.act_window">
        <field name="name">Metricas de Monitoreo</field>
        <field name="res_model">network.monitor</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
