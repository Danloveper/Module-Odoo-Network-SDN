<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="network_config_view_form" model="ir.ui.view">
        <field name="name">network.config.view.form</field>
        <field name="model">network.config</field>
        <field name="arch" type="xml">
            <form string="Config SDN">
                <sheet>
                    <h1 class="mt0">
                        <field name="name" class="mb16" />
                    </h1>
                    <group>
                        <group>
                            <field name="description" />
                        </group>
                    </group>
                    <field name="message_rpc" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="network_config_view_tree" model="ir.ui.view">
        <field name="name">network.config.view.tree</field>
        <field name="model">network.config</field>
        <field name="arch" type="xml">
            <tree string="Config SDN">
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="network_config_action" model="ir.actions.act_window">
        <field name="name">Configuraciones del controlador</field>
        <field name="res_model">network.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
